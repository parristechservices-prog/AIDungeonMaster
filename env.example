# Copy to .env.local for local development

# LLM provider order: groq (default), openrouter, openai
# Use commas for failover, e.g. groq,openrouter,openai
PARTYQUEST_LLM_PROVIDER=groq
PARTYQUEST_LLM_MODE=light

# Groq (recommended for dev — fast, low cost)
# Primary Groq API key (used first):
GROQ_API_KEY=
# Optional comma-separated backup Groq keys for failover:
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (used when PARTYQUEST_LLM_PROVIDER includes openai, e.g. groq,openai)
# Primary OpenAI key (used when provider=openai):
OPENAI_API_KEY=
# Optional comma-separated backup OpenAI keys for failover:
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (used when PARTYQUEST_LLM_PROVIDER includes openrouter)
OPENROUTER_API_KEY=
# Optional comma-separated backup OpenRouter keys for failover:
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Optional OpenRouter metadata:
OPENROUTER_APP_NAME=PartyQuest
OPENROUTER_SITE_URL=

# Dev logging to .data/ (local only)
PARTYQUEST_DEV_LOGS=true

# Skip LLM HTTP when no API keys (faster mock/table-rules play)
# PARTYQUEST_FORCE_MOCK=true

# Set false to omit the table-rules narration prefix on fallback turns
# PARTYQUEST_MOCK_FLAVOR=true

# Optional per-session turn cap. Leave unset or 0 for unlimited.
# PARTYQUEST_MAX_TURNS_PER_SESSION=100

# Supabase transaction-mode pooler (port 6543) — see docs/persistence-and-spatial-plan.md
DATABASE_URL=
